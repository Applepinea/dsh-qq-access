# 依赖
node_modules/
.pnpm-store/

# 构建产物
*.tgz
dist/
build/

# 本地配置与运行时数据
# config.json 里是 QQ 号、cookie、token，data/ 下面是聊天归档、
# 记忆、情感、日程等真实数据。这个目录只是发布用的快照，
# 万一被 git 接管也不能让这些东西进去。
config.json
*.local.json
data/
*.log
debug.log

# 包管理器与工具缓存
.npm/
.cache/
.eslintcache

# 编辑器与系统
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# 备份与临时文件
*.bak
*.tmp
*.orig

# 升级时自动生成的旧版本快照（含旧配置与旧日志，不进版控）
.backup-*/
